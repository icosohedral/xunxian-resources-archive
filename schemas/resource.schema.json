{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xunxian.wiki/schemas/resource.schema.json",
  "title": "可追溯资源记录",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resource_kind",
    "resource_id",
    "display_name",
    "source_file",
    "source_row",
    "raw_values",
    "build_id"
  ],
  "properties": {
    "resource_kind": {
      "enum": ["item", "quest_item", "pet", "title", "ride"]
    },
    "resource_id": {
      "type": "integer",
      "minimum": 0
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "source_file": {
      "type": "string",
      "minLength": 1,
      "not": {"pattern": "^(/|[A-Za-z]:\\\\)"}
    },
    "source_row": {
      "type": "integer",
      "minimum": 1
    },
    "raw_values": {
      "type": "array",
      "items": {"type": "string"}
    },
    "metadata": {
      "type": "object"
    },
    "build_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
