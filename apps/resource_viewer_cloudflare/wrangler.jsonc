{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xunxian-resource-archive",
  "main": "src/entry.py",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["python_workers"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "xunxian.wiki",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "RESOURCE_DB",
      "database_name": "xunxian-resource-archive",
      "database_id": "d57290bb-90fc-4a88-8476-d04bc5a2667c"
    },
    {
      "binding": "VISITS_DB",
      "database_name": "xunxian-resource-visits",
      "database_id": "c925242a-2855-40ca-b5f0-a4284cf03b24"
    }
  ]
}
